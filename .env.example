# Tab "🚀 Potensi 100x" butuh API key GMGN sendiri (BUKAN gratis publik).
# Daftar & apply di: https://gmgn.ai/ai
# Free tier: 5 request/detik. Cukup untuk read-only (tanpa private key).
# TIDAK wajib buat tab "🔭 Wallet Watch" / "🎯 Pilih 3 Dompet" — di 2 tab itu
# kalau kosong, discovery jalan pakai Helius (sol) +
# Etherscan (eth/bsc/base) di bawah, tanpa GMGN.
# ROTASI OTOMATIS: isi sampai 5 key dipisah koma. Dipilih otomatis (paling sedikit
# dipakai), tiap key di-throttle sendiri (~4.5 req/s) dan pindah key sendiri
# kalau kena rate limit / key invalid.
GMGN_API_KEYS=
# (Lama, tetap jalan & digabung ke pool) 1 key saja:
GMGN_API_KEY=
# Opsional: jeda minimum antar request per key dalam ms (default 220).
GMGN_MIN_GAP_MS=220

# Tab "🔭 Wallet Watch" / "🎯 Pilih 3 Dompet" — dipakai buat DISCOVERY dompet
# di chain EVM (BSC/Base/Ethereum), pengganti GRATIS buat GMGN top-traders di
# chain itu (tarik transfer terakhir token, ranking penerima paling aktif).
# GRATIS, daftar di: https://etherscan.io/apis (bukan tier Pro/berbayar).
# 1 API key ini otomatis berlaku juga untuk BSC & Base (Etherscan API V2).
# ROTASI OTOMATIS: isi sampai 5 key dipisah koma (paling sedikit dipakai dulu,
# pindah key sendiri kalau kena limit per-detik / per-hari / key invalid).
ETHERSCAN_API_KEYS=
# (Lama, tetap jalan & digabung ke pool) 1 key saja:
ETHERSCAN_API_KEY=
# Opsional: jeda minimum antar request per key (ms, default 350) & batas lunak
# request per key per hari (default 90000 dari 100000 free tier).
ETHERSCAN_MIN_GAP_MS=350
ETHERSCAN_DAILY_REQUESTS_PER_KEY=90000

# Tab "🔭 Wallet Watch" / "🎯 Pilih 3 Dompet" chain Solana: holder token +
# riwayat transaksi wallet lewat Helius. Solscan publik sudah mati (401/404).
# Daftar gratis di: https://dashboard.helius.dev (1M credit / 30 hari / key)
# ROTASI OTOMATIS: isi sampai 5 key dipisah koma. Dipilih otomatis (paling
# sedikit dipakai) + pindah key sendiri kalau kena 429/limit.
HELIUS_API_KEYS=
# (Lama, tetap jalan & digabung ke pool) 1 key saja:
HELIUS_API_KEY=
# Batas lunak credit per key per hari (default 30000 = ~900k/bulan, sisakan buffer 10%).
# Kalau semua key lewat batas ini, request Solana ditolak dengan pesan jelas.
HELIUS_DAILY_CREDITS_PER_KEY=30000

# Tab "💹 CEX" > "💱 Forex & Gold" — sumber data Twelve Data.
# Daftar gratis di: https://twelvedata.com (free: 8 credit/menit, 800 credit/hari per key).
# ROTASI OTOMATIS: isi sampai 10 key dipisah koma. Dipilih otomatis (paling sedikit
# dipakai + masih punya jatah menit ini), pindah key sendiri kalau kena 429/limit.
# 4h TIDAK pakai Twelve Data (tidak tersedia) -> Tiingo (lihat di bawah).
# 1 scan = 12 instrumen x 5 TF (5m,15m,30m,1h,1d) = 60 credit -> muat di 10 key x 8/menit.
TWELVEDATA_API_KEYS=
# (Opsional) 1 key saja, digabung ke pool:
TWELVEDATA_API_KEY=
# Opsional: limit per menit per key (default 8) & batas lunak harian per key (default 780).
TWELVEDATA_CREDITS_PER_MIN=8
TWELVEDATA_DAILY_CREDITS_PER_KEY=780

# Tab "💹 CEX" > "💱 Forex & Gold" — sumber KHUSUS 4h: Tiingo FX (REST).
# Daftar gratis di: https://tiingo.com -> ambil token di menu API.
# Isi 1 key, atau beberapa dipisah koma (dirotasi otomatis). Kalau kosong / gagal,
# 4h otomatis dibentuk dari candle 1h Twelve Data (+1 credit per pair).
TIINGO_API_KEYS=
